# MeridianLib Environment Configuration Template
# Copy to .env.local (excluded from submission ZIP) and fill in your credentials.

MLIB_SQLITE_PATH=meridianlib.db

MLIB_MYSQL_HOST=<your-mysql-host>
MLIB_MYSQL_PORT=3306
MLIB_MYSQL_USER=<your-limited-mysql-user>
MLIB_MYSQL_PASSWORD=<your-mysql-password>
MLIB_MYSQL_DB=meridianlib

MLIB_PG_HOST=<your-postgres-host>
MLIB_PG_PORT=5432
MLIB_PG_USER=<your-limited-postgres-user>
MLIB_PG_PASSWORD=<your-postgres-password>
MLIB_PG_DB=meridianlib

MLIB_TIMEOUT=3

